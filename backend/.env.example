# ─────────────────────────────────────────────────────────────────────────────
# SYS5 artifact generator — environment configuration
#
# Copy to `.env` and fill in the LLM connection values. Every other variable has
# a working default. Keys passed in the runtime config dict override these.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (on-prem gpt-oss-120b, OpenAI-compatible endpoint) ───────────────────
# Reached only via langchain_openai.ChatOpenAI.
SYS5_LLM_BASE_URL=http://<host>:<port>/v1     # required (falls back to OPENAI_BASE_URL)
SYS5_LLM_API_KEY=<key>                        # required (falls back to OPENAI_API_KEY)
SYS5_LLM_MODEL=llm-1-gpt-oss-120b             # also settable via config["model"]
SYS5_LLM_TEMPERATURE=0
SYS5_LLM_MAX_TOKENS=8192                      # max completion tokens per call
SYS5_LLM_CONTEXT_LIMIT=100000                 # hard window; the budgeter never exceeds it
SYS5_LLM_CONTEXT_RESERVE=8000                 # headroom kept free for the completion
SYS5_LLM_TIMEOUT=180                          # seconds per request
SYS5_LLM_MAX_RETRIES=3
SYS5_LLM_MAX_CONCURRENCY=3                    # parallel Send branches (on-prem endpoint)
SYS5_LLM_STRUCTURED_METHOD=auto               # auto | json_schema | json_mode | function_calling

# ── Output selection (the "next format" switch) ──────────────────────────────
SYS5_OUTPUT_TEMPLATE=tmhc_v1                  # registered template name; fail-fast if unknown
SYS5_OUTPUT_FORMAT=excel                      # excel | csv | json
SYS5_PROJECT_PROFILE=tmhc                     # tmhc | generic

# ── Pipeline behaviour ───────────────────────────────────────────────────────
SYS5_MAX_VALIDATION_ATTEMPTS=2
SYS5_MAX_CORRECTION_ATTEMPTS=1
SYS5_REQ_KEYWORDS=sys5 test,sys test,system qualification,system test,sqt
SYS5_FUZZY_THRESHOLD=85
SYS5_WORK_DIR=                                # intermediates; default <sys5 pkg>/_work
SYS5_KEEP_INTERMEDIATES=true
SYS5_CHECKPOINT_DB=                           # SqliteSaver path; empty = in-memory
SYS5_LOG_LEVEL=INFO

# ── Optional tracing ─────────────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sys5
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
